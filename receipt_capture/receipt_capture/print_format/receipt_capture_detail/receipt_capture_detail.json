{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-10-25 10:00:00.000000",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Receipt Capture",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 0,
 "html": "<style>\n  .rc-header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #1f2937; padding-bottom: 8px; margin-bottom: 16px; }\n  .rc-title { font-size: 20px; font-weight: 700; margin: 0; }\n  .rc-muted { color: #6b7280; font-size: 11px; }\n  .rc-status { padding: 2px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; background: #e5e7eb; }\n  .rc-grid { display: flex; gap: 24px; margin-bottom: 16px; }\n  .rc-grid > div { flex: 1; }\n  .rc-label { color: #6b7280; font-size: 10px; text-transform: uppercase; letter-spacing: .05em; }\n  .rc-value { font-size: 13px; font-weight: 600; }\n  table.rc-items { width: 100%; border-collapse: collapse; margin-bottom: 12px; }\n  table.rc-items th { text-align: left; font-size: 10px; text-transform: uppercase; color: #6b7280; border-bottom: 1px solid #d1d5db; padding: 6px 4px; }\n  table.rc-items td { border-bottom: 1px solid #f3f4f6; padding: 6px 4px; font-size: 12px; }\n  .text-right { text-align: right; }\n  .rc-totals { width: 45%; margin-left: auto; }\n  .rc-totals td { padding: 3px 4px; font-size: 12px; }\n  .rc-grand td { font-weight: 700; font-size: 14px; border-top: 2px solid #1f2937; }\n  .rc-notes { background: #fffbeb; border: 1px solid #fcd34d; padding: 8px; font-size: 11px; margin-top: 12px; white-space: pre-line; }\n  .rc-image { max-width: 260px; max-height: 360px; border: 1px solid #d1d5db; margin-top: 16px; }\n</style>\n\n<div class=\"rc-header\">\n  <div>\n    <p class=\"rc-title\">{{ _(\"Receipt\") }} {{ doc.name }}</p>\n    <div class=\"rc-muted\">{{ _(\"Captured by AI extraction\") }}{% if doc.model_used %} &middot; {{ doc.model_used }}{% endif %}</div>\n  </div>\n  <span class=\"rc-status\">{{ _(doc.status) }}</span>\n</div>\n\n<div class=\"rc-grid\">\n  <div>\n    <div class=\"rc-label\">{{ _(\"Vendor\") }}</div>\n    <div class=\"rc-value\">{{ doc.supplier or doc.supplier_name or \"-\" }}</div>\n  </div>\n  <div>\n    <div class=\"rc-label\">{{ _(\"Bill Date\") }}</div>\n    <div class=\"rc-value\">{{ frappe.utils.formatdate(doc.bill_date) if doc.bill_date else \"-\" }}</div>\n  </div>\n  <div>\n    <div class=\"rc-label\">{{ _(\"Bill Number\") }}</div>\n    <div class=\"rc-value\">{{ doc.bill_number or \"-\" }}</div>\n  </div>\n  <div>\n    <div class=\"rc-label\">{{ _(\"Purchase Invoice\") }}</div>\n    <div class=\"rc-value\">{{ doc.purchase_invoice or _(\"Not created\") }}</div>\n  </div>\n</div>\n\n{% if doc.items %}\n<table class=\"rc-items\">\n  <thead><tr><th>#</th><th>{{ _(\"Description\") }}</th><th class=\"text-right\">{{ _(\"Qty\") }}</th><th class=\"text-right\">{{ _(\"Rate\") }}</th><th class=\"text-right\">{{ _(\"Amount\") }}</th></tr></thead>\n  <tbody>\n  {% for row in doc.items %}\n    <tr>\n      <td>{{ row.idx }}</td>\n      <td>{{ row.description }}</td>\n      <td class=\"text-right\">{{ frappe.utils.fmt_money(row.qty, precision=2) }}</td>\n      <td class=\"text-right\">{{ row.get_formatted(\"rate\", doc) }}</td>\n      <td class=\"text-right\">{{ row.get_formatted(\"amount\", doc) }}</td>\n    </tr>\n  {% endfor %}\n  </tbody>\n</table>\n{% endif %}\n\n<table class=\"rc-totals\">\n  <tr><td>{{ _(\"Items Total\") }}</td><td class=\"text-right\">{{ doc.get_formatted(\"lines_total\") }}</td></tr>\n  <tr><td>{{ _(\"Tax\") }}</td><td class=\"text-right\">{{ doc.get_formatted(\"tax_amount\") }}</td></tr>\n  <tr class=\"rc-grand\"><td>{{ _(\"Total\") }}</td><td class=\"text-right\">{{ doc.get_formatted(\"total_amount\") }}</td></tr>\n</table>\n\n{% if doc.review_notes %}<div class=\"rc-notes\"><b>{{ _(\"Review notes\") }}:</b>\n{{ doc.review_notes }}</div>{% endif %}\n\n{% if doc.receipt_image %}<img class=\"rc-image\" src=\"{{ doc.receipt_image }}\" alt=\"{{ _('Receipt image') }}\">{% endif %}\n",
 "idx": 0,
 "line_breaks": 0,
