# Copy to .env and change the passwords. .env is gitignored.
DB_ROOT_PASSWORD=change-me-db-root
ADMIN_PASSWORD=change-me-admin
SITE_NAME=erp.localhost
HTTP_PORT=8080

# Any model from https://ollama.com/library. qwen2.5:1.5b runs on CPU with ~2 GB RAM;
# larger models (e.g. llama3.1:8b) extract more accurately but need more memory.
OLLAMA_MODEL=qwen2.5:1.5b
# CPU-only by default; use ollama/ollama on a GPU host
OLLAMA_IMAGE=alpine/ollama:latest
